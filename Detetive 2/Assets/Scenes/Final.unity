  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcFinal
  painelCaderno: {fileID: 541248075}
  botaoOlharCaderno: {fileID: 128598345}
  textoCaderno: {fileID: 246844640}
  botoesAnotacoes:
  - {fileID: 308055603}
  - {fileID: 1578517293}
  - {fileID: 1388300269}
  painelFalaJogador: {fileID: 1537067427}
  textoFalaJogador: {fileID: 914882274}
  tempoFalaJogador: 3
  velocidadeDigitacao: 0.025
  campoTexto: {fileID: 1155430244}
  textoResposta: {fileID: 15821973}
  textoDigitando: {fileID: 1005571426}
  botaoEnviar: {fileID: 257971135}
  painelRespostaSuspeito: {fileID: 0}
  playerMovement: {fileID: 2086589863}
  animatorNpc: {fileID: 1351997175}
  triggerNegacao: Negar
  triggerProva: Nervoso
  respostasNegacao:
  - Nao sei de nada. Eu nao estava envolvido.
  - Ja disse, nao tenho nada a ver com isso.
  - Voce esta perdendo tempo comigo.
  - Nao vou responder isso.
  - Eu nao fiz nada de errado.
  - Nao sei do que voce esta falando.
  - Voce nao tem nenhuma prova contra mim.
  painelProvas: {fileID: 4188712}
  botaoGarrafa: {fileID: 427438306}
  botaoFaca: {fileID: 79944217}
  botaoDigital: {fileID: 638471198}
  imagemGarrafa: {fileID: 1304488938}
  imagemFaca: {fileID: 995346783}
  imagemDigital: {fileID: 2031491998}
  spriteGarrafa: {fileID: 842469982, guid: a7e7af5369b8a4b4aa39ab5ffd2b4ff6, type: 3}
  spriteFaca: {fileID: -1975598403, guid: 15df00dc1cf20a64d81c98f08fba63b6, type: 3}
  spriteDigital: {fileID: 600268915, guid: e84f39f7dedf7c04d9724e78b18731b6, type: 3}
  corPistaUsada: {r: 0.5, g: 0.5, b: 0.5, a: 1}
  tempoProva: 10
  contadorGarrafa: {fileID: 592726512}
  contadorFaca: {fileID: 40808156}
  contadorDigital: {fileID: 2050511735}
  respostaGarrafa: Essa garrafa nao prova nada! Eu nunca vi isso antes.
  respostaFaca: "Essa faca... eu nao sei de onde voc\xEA tirou isso."
  respostaDigital: "Essas digitais... nao... isso nao pode ser poss\xEDvel."
  textoConfissao: {fileID: 1759166374}
  esperaAntesConfissao: 1
  tempoEntreBlocos: 0.4
  tempoMinimoBloco: 3
  tempoPorLetraConfissao: 0.045
  blocosConfissao:
  - Esta bem... Eu confesso! Fui eu.
  - Eu trabalhava com ele ha muito tempo.
  - Certo dia, descobri que ele desviava uma parte do meu salario para a conta dele.
  - Tivemos uma discussao feia naquele dia.
  - Em casa, eu ainda estava muito nervoso e agi por impulso.
  - Esculpi uma estaca de gelo com uma faca e a coloquei em uma garrafa termica,
    pois achei que ninguem ia conseguir descobrir quem matou.
  - Fui ate a casa dele e o ataquei na sauna.
  - Depois, virei a casa dele de pernas pro ar, como ele fez com a minha vida.
  - Me arrependo muito do que fiz.
  triggersConfissao:
  - Confessar1
  - Confessar2
  tempoPonto: 0.3
  tempoAntesResposta: 0.8
  tempoRespostaVisivel: 3
  fadeCanvasGroup: {fileID: 1109968279}
  duracaoFade: 1.5
  transition: {fileID: 307845784}
  delayTransicao: 1
  nomeProximaCena: CutsceneAssassinato
  popupExplicativo: {fileID: 1586153278}
  textoExplicacao: {fileID: 243509347}
  tempoPopup: 4
