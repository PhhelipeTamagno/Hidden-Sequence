--- !u!114 &1440745267
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1440745265}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: " HIDDEN SEQUENCE\r\n\r\nCR\xC9DITOS FINAIS\r\n\r\n DESENVOLVIDO POR\r\n\r\n
    GABRIEL LANGA GUTJHAR\r\n\r\nGAME DESIGN\r\n\r\nRespons\xE1vel pela concep\xE7\xE3o
    das ideias, cria\xE7\xE3o das mec\xE2nicas e desenvolvimento da experi\xEAncia
    de jogo, definindo os elementos que d\xE3o identidade a Hidden Sequence.\r\n\r\nENZO
    SCHLAGEL\r\n\r\n3D ARTIST | MODELADOR 3D\r\n\r\nRespons\xE1vel pela cria\xE7\xE3o
    dos modelos tridimensionais e dos elementos visuais que comp\xF5em o universo
    de Hidden Sequence, contribuindo para a identidade visual do projeto.\r\n\r\n
    PHELIPE TAMAGNO\r\n\r\nPROGRAMADOR | GAMEPLAY PROGRAMMING\r\n\r\nRespons\xE1vel
    pelo desenvolvimento dos sistemas, implementa\xE7\xE3o das mec\xE2nicas e programa\xE7\xE3o
    dos recursos que tornam a experi\xEAncia de jogo poss\xEDvel.\r\n\r\n AGRADECIMENTOS
    ESPECIAIS\r\n\r\nToda jornada chega ao fim, mas algumas experi\xEAncias permanecem.\r\n\r\nHidden
    Sequence \xE9 um jogo inspirado no jogo de cartas:Black Stories e tambem o resultado
    de in\xFAmeras ideias, horas de trabalho, desafios e dedica\xE7\xE3o. Cada detalhe
    deste projeto representa uma parte do esfor\xE7o de todos os envolvidos em sua
    cria\xE7\xE3o.\r\n\r\nA voc\xEA, que chegou at\xE9 aqui, nosso mais sincero agradecimento.
    Esperamos que sua jornada por este universo tenha sido t\xE3o marcante quanto
    foi a nossa durante seu desenvolvimento.\r\n\r\nOBRIGADO POR FAZER PARTE DESTA
    EXPERI\xCANCIA.\r\n\r\nHIDDEN SEQUENCE\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 85519acdc518cfe4a8d884c064e8e771, type: 2}
  m_sharedMaterial: {fileID: -2025313383525767675, guid: 85519acdc518cfe4a8d884c064e8e771, type: 2}
