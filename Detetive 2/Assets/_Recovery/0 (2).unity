  popupExplicativoCanvasGroup: {fileID: 1586153282}
  textoExplicacao: {fileID: 243509347}
  mensagemExplicacao: "Voc\xEA ter\xE1 apenas 3 perguntas para interrogar o suspeito.
    Escolha com cuidado!"
  duracaoAnimacaoPopup: 0.5
  distanciaQueda: 100
  tempoVisivelPopup: 3
  respostasNegacao:
  - "N\xE3o sei de nada. Eu n\xE3o estava envolvido."
  - "J\xE1 disse, n\xE3o tenho nada a ver com isso."
  - "Voc\xEA est\xE1 perdendo tempo comigo, eu n\xE3o vi nada."
  - "N\xE3o vou responder isso. N\xE3o fiz nada de errado."
  - "Isso n\xE3o tem nada a ver comigo, procure outra pessoa."
  textoMensagem: {fileID: 2120231417}
  mensagemFinal: "Ap\xF3s interrogar o suspeito, voc\xEA decide seguir para a cena
    do crime em busca de pistas."
